meta {
  name: Get Signature Sandbox - Token
  type: http
  seq: 2
}

post {
  url: {{base-url-signature-sandbox}}/tools/snap/generate-signature-b2b
  body: json
  auth: none
}

body:json {
  {
      "privateKey": "{{private-key-sandbox}}",
      "clientId": "{{client-id-sandbox}}",
      "timestamp": "{{X-TIMESTAMP}}"
  }
}

script:pre-request {
  //## FOR TIMESTAMP
  
  // 1. Ambil waktu UTC saat ini
  const now = new Date();
  
  // 2. Geser waktu ke UTC+7 (Jakarta) dengan menambahkan 7 jam (7 * 60 * 60 * 1000 ms)
  const offsetJakarta = 7 * 60 * 60 * 1000;
  const jakartaTime = new Date(now.getTime() + offsetJakarta);
  
  // 3. Format komponen tanggal & waktu secara manual (ISO 8601)
  const pad = (num) => String(num).padStart(2, '0');
  
  const yyyy = jakartaTime.getUTCFullYear();
  const MM = pad(jakartaTime.getUTCMonth() + 1); // Bulan dimulai dari 0
  const dd = pad(jakartaTime.getUTCDate());
  const HH = pad(jakartaTime.getUTCHours());
  const mm = pad(jakartaTime.getUTCMinutes());
  const ss = pad(jakartaTime.getUTCSeconds());
  
  // 4. Gabungkan menjadi format yyyy-MM-ddTHH:mm:ss+07:00
  const formattedDate = `${yyyy}-${MM}-${dd}T${HH}:${mm}:${ss}+07:00`;
  
  // 5. Simpan ke variabel Bruno
  bru.setVar("X-TIMESTAMP", formattedDate);
}

script:post-response {
  var jsonData = res.getBody();
  bru.setVar("X-SIGNATURE",  jsonData.signature)
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  PARAMETER
  =========
  privateKey => Private Key (Provide from RAYA OPEN API)
  clientId => Client ID (Provide from RAYA OPEN API)
  timestamp => Now (Format : 2026-06-18T12:46:05+07:00) == harus selalu sama sampai ke request access token
}

example {
  name: Success
  
  request: {
    url: http://10.99.0.240:3000/tools/snap/generate-signature-b2b
    method: POST
    mode: json
    body:json: {
      {
          "privateKey": "{{private-key-sandbox}}",
          "clientId": "{{client-id-sandbox}}",
          "timestamp": "{{X-TIMESTAMP}}"
      }
    }
  }
  
  response: {
    headers: {
      content-type: application/json; charset=utf-8
      content-length: 360
      etag: W/"168-o+3hlXcmHvg6jLYaie1IMdDHWpo"
      date: Thu, 18 Jun 2026 05:46:06 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "signature": ""
        }
      '''
    }
  }
}
